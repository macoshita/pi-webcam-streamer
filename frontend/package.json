    "daisyui": "^5.5.18",
    "lucide-svelte": "^0.564.0",
    "postcss": "^8.5.6",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
